# Ключи Binance. Для тестнета: https://testnet.binancefuture.com
BINANCE_API_KEY=
BINANCE_API_SECRET=

# paper   — локальная симуляция на реальных котировках, без ордеров
# testnet — реальные ордера на тестнете Binance Futures
# live    — РЕАЛЬНЫЕ ДЕНЬГИ
MODE=paper

SYMBOL=BTC/USDT:USDT
TIMEFRAME=5m
LEVERAGE=10

# Риск на сделку в % от текущего депозита (стоп-лосс = потеря этого %)
RISK_PER_TRADE_PCT=2
# Цель разгона: бот останавливается, когда депозит вырос на X %
TARGET_PROFIT_PCT=100
# Аварийная остановка при просадке от стартового депозита
MAX_DRAWDOWN_PCT=30
# Остановка после N убыточных сделок подряд
MAX_CONSECUTIVE_LOSSES=4

# Параметры стратегии
EMA_FAST=9
EMA_SLOW=21
RSI_PERIOD=14
ATR_PERIOD=14
STOP_ATR_MULT=1.5
TAKE_PROFIT_RR=2.0

# Только для MODE=paper
PAPER_BALANCE=100
