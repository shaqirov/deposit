# Ключи Binance. Для тестнета: https://testnet.binancefuture.com
BINANCE_API_KEY=
BINANCE_API_SECRET=

# paper   — локальная симуляция на реальных котировках, без ордеров
# testnet — реальные ордера на тестнете Binance Futures
# demo    — демо-трейдинг Binance (demo.binance.com)
# live    — РЕАЛЬНЫЕ ДЕНЬГИ
MODE=paper

SYMBOL=BTC/USDT:USDT
# Проверено в бэктестах на 4h
TIMEFRAME=4h
# Плечо только ограничивает максимальный объём; риск задаёт стоп
LEVERAGE=3

# --- Риск-менеджмент ---
# Риск на сделку в % от текущего депозита (стоп-лосс = потеря этого %)
RISK_PER_TRADE_PCT=1
# Остановка, когда депозит вырос на X % (0 — без цели)
TARGET_PROFIT_PCT=100
# Аварийная остановка при просадке от стартового депозита
MAX_DRAWDOWN_PCT=25
# После N убытков подряд — перерыв на PAUSE_HOURS часов (0 — полная остановка)
MAX_CONSECUTIVE_LOSSES=3
PAUSE_HOURS=48
# Не открывать лонг при funding выше X % за 8ч, шорт — ниже -X % (0 — выключено)
MAX_FUNDING_PCT=0.05
# Новости: файл с датами событий (UTC) и окно, когда новые сделки не открываются
NEWS_FILE=news.txt
NEWS_HOURS_BEFORE=12
NEWS_HOURS_AFTER=4

# --- Стратегия: пробой канала по направлению тренда (bot/strategy.py) ---
# Период канала: вход при пробое максимума/минимума последних N свечей
DONCHIAN_PERIOD=20
# Торговать только по тренду: лонг выше EMA, шорт ниже
TREND_EMA=200
# Стоп = STOP_ATR_MULT * ATR, тейк = TAKE_PROFIT_RR стопов
ATR_PERIOD=14
STOP_ATR_MULT=1.5
TAKE_PROFIT_RR=2.0

# Только для MODE=paper и бэктеста
PAPER_BALANCE=100
