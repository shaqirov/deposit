[Unit]
Description=Binance Futures trading bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=bot
WorkingDirectory=/opt/deposit
ExecStart=/opt/deposit/.venv/bin/python -m bot.main
# Перезапуск при сбое и по командам /restart, /set, /update из Telegram (код выхода 3)
Restart=on-failure
RestartSec=5
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
